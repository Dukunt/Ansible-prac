- name: configuration using loops
  hosts: local
  connection: local
  become : yes
  tasks:
  - name: update software using loops_demo
    ansible.builtin.package:
     name: "{{item}}"
     state: present
    loop:
     - nginx
     - mysql

  - name: start service
    ansible.builtin.service:
     name: "{{item}}"
     state: started
     enabled: yes
    loop:
     - nginx




