- name: Shell vs command module demo
  hosts: local
  connection: local
  tasks:
   - name: shell module demo
     ansible.builtin.shell: cat /etc/passwd | grep root
     register: user_output

   - name: print the user output in shell module
     ansible.builtin.debug:
      msg: " {{user_output}} "

   - name: command module demo
     ansible.builtin.shell: ls -ltr > files.txt
     register: files_output

   - name: print the user output in shell module
     ansible.builtin.debug:
      msg: " {{files_output}} "  





